# Copy to .env and fill in real values. NEVER commit the real .env.
APP_ENV=local
APP_NAME=product-backend
LOG_LEVEL=INFO

# SQL Server connection (matches infra/docker-compose.yml for local dev)
DATABASE_URL=mssql+pyodbc://sa:YourStrong!Passw0rd@localhost:1433/product_db?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# Auth
JWT_SECRET_KEY=change-me-generate-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS — frontend dev server origin
CORS_ORIGINS=["http://localhost:5173"]
